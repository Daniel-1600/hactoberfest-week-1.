# Backend paths are relative to backend/ (make dev-backend runs from there).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=../data/ecosound.sqlite
AUDIO_STORAGE_DIR=../data/audio
PYTHON_EXECUTABLE=../.venv/bin/python
INFERENCE_SCRIPT=../inference/identify.py
INFERENCE_TIMEOUT=180s
QUEST_TIMEZONE=Africa/Nairobi
# BirdNET assets: relative to backend working directory; never committed.
BIRDNET_APP_DATA=../data/birdnet
# Copy this variable to frontend/.env.local for Next.js, or export it before startup.
NEXT_PUBLIC_API_URL=http://localhost:8080
