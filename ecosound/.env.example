# Backend paths are relative to backend/ (make dev-backend runs from there).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=../data/ecosound.sqlite
AUDIO_STORAGE_DIR=../data/audio
PYTHON_EXECUTABLE=../.venv/bin/python
INFERENCE_SCRIPT=../inference/identify.py
INFERENCE_TIMEOUT=180s
QUEST_TIMEZONE=Africa/Nairobi
# Select local BirdNET by default, or use the authenticated Modal service.
INFERENCE_PROVIDER=local
BIRDNET_MODAL_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# BirdNET assets: relative to backend working directory; never committed.
BIRDNET_APP_DATA=../data/birdnet
# Copy this variable to frontend/.env.local for Next.js, or export it before startup.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional long-running local Qwen3-compatible server (for example Ollama).
QWEN_ENABLED=false
QWEN_PROVIDER=local
QWEN_MODEL_PATH=qwen3:1.7b
QWEN_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
QWEN_TIMEOUT_SECONDS=180
# For QWEN_PROVIDER=modal, use the deployed base URL and a separate proxy token.
QWEN_MODAL_URL=
QWEN_MODAL_PROXY_TOKEN_ID=
QWEN_MODAL_PROXY_TOKEN_SECRET=

# Experimental provider remains disabled unless its gated model environment is installed.
NATURELM_ENABLED=false
NATURELM_MODEL_PATH=EarthSpeciesProject/NatureLM-audio
NATURELM_TIMEOUT_SECONDS=120

NEXT_PUBLIC_OFFLINE_CACHE_ENABLED=true
PUBLIC_MAP_ENABLED=true
OBSERVATION_LOCATION_PRECISION=coarse
NATURELM_ENDPOINT=http://127.0.0.1:8091
NATURELM_REPO_PATH=
